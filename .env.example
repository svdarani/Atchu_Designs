# Security & Sessions
JWT_SECRET=atchu_designs_jwt_secret_key_change_in_production_98421
SESSION_EXPIRY_DAYS=7

# Initial Provisioning for Boutique Owner Admin (orders.atchudesigns@gmail.com)
# Note: On first server boot, this password is used to generate a salted SHA-512
# hash in the secure database, and is never exposed to the frontend or API responses.
ADMIN_INITIAL_PASSWORD=AtchuAdmin@Balasamuthiram2026!

# Google OAuth 2.0 Credentials (From Google Cloud Console: https://console.cloud.google.com/)
# Set Authorized redirect URI to: http://localhost:5174/api/auth/google/callback (or production domain)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5174/api/auth/google/callback

# Server & Boutique Location
PORT=5174
NODE_ENV=development
